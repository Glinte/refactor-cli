{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Glinte/refactor-cli/schema/protocol-v1.schema.json",
  "title": "refactor-cli protocol v1",
  "$defs": {
    "descriptor": {
      "type": "object",
      "required": ["protocolVersion", "idePid", "ideBuild", "port", "token", "projects"],
      "properties": {
        "protocolVersion": { "const": 1 },
        "idePid": { "type": "integer", "minimum": 1 },
        "ideBuild": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "token": { "type": "string", "minLength": 32 },
        "projects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "required": ["symbol"],
          "properties": {
            "symbol": { "type": "string", "minLength": 1 },
            "expect": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["file", "line", "col"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "col": { "type": "integer", "minimum": 1 },
            "expect": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "params": {
      "type": "object",
      "required": ["project"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "selector": { "$ref": "#/$defs/selector" },
        "touched": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "max": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "to": { "type": "string", "minLength": 1 },
        "dryRun": { "type": "boolean" },
        "forceNonSource": { "type": "boolean" },
        "diff": { "enum": ["none", "inline", "file"] }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": "integer" },
        "method": {
          "enum": ["status", "sync", "resolve", "usages", "rename"]
        },
        "params": { "$ref": "#/$defs/params" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "method": { "enum": ["resolve", "usages", "rename"] } },
            "required": ["method"]
          },
          "then": {
            "properties": { "params": { "required": ["project", "selector"] } }
          }
        },
        {
          "if": {
            "properties": { "method": { "const": "rename" } },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "params": {
                "required": [
                  "project",
                  "selector",
                  "to",
                  "dryRun",
                  "forceNonSource",
                  "diff"
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {},
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message", "data"],
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {
              "type": "object",
              "required": ["code", "exitCode"],
              "properties": {
                "code": { "type": "string" },
                "exitCode": { "enum": [2, 3, 4, 5] }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "oneOf": [
        { "required": ["result"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["result"] } }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/descriptor" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ]
}
